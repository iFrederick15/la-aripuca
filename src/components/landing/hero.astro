<!-- HERO -->
<section
  class="hero-section relative flex min-h-svh w-full flex-col items-center justify-center overflow-hidden"
>
  <!-- Background -->
  <img
    class="absolute inset-0 h-full w-full object-cover object-center"
    src="/images/aripuca-compromiso.jpeg"
    alt="Vista exterior de La Aripuca, gigantesca trampa de madera nativa en Puerto Iguazú"
    fetchpriority="high"
  />

  <!-- Layered cinematic overlays -->
  <div class="absolute inset-0 bg-linear-to-b from-black/75 via-black/25 to-black/85"></div>
  <div class="absolute inset-0 bg-linear-to-r from-[#2a0e00]/60 via-transparent to-[#2a0e00]/60"></div>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse 80% 60% at 50% 40%, transparent 25%, rgba(20,8,0,0.65) 100%)"
  ></div>

  <!-- Decorative top border -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-linear-to-r from-transparent via-[#BFB065] to-transparent opacity-70"></div>

  <!-- Bottom fade: transición suave hacia la sección siguiente -->
  <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-48 bg-linear-to-t from-black to-transparent"></div>

  <!-- Main content -->
  <div class="hero-content relative z-10 flex w-full flex-col items-center px-6 pb-16 pt-28 text-center md:pt-32">

    <!-- Badge location -->
    <div class="hero-badge mb-6 inline-flex items-center gap-2 rounded-full border border-[#BFB065]/40 bg-black/30 px-4 py-1.5 backdrop-blur-sm">
      <span class="h-1.5 w-1.5 rounded-full bg-[#BFB065]"></span>
      <span class="font-title text-xs font-bold uppercase tracking-[0.25em] text-[#BFB065]">Puerto Iguazú · Misiones · Argentina</span>
      <span class="h-1.5 w-1.5 rounded-full bg-[#BFB065]"></span>
    </div>

    <!-- Main title -->
    <h1 class="hero-title font-title mb-4 leading-none tracking-wide text-white">
      <span
        class="block text-5xl font-black uppercase sm:text-7xl md:text-8xl lg:text-9xl"
        style="text-shadow: 0 0 60px rgba(191,176,101,0.35), 0 6px 30px rgba(0,0,0,0.95), 0 2px 0px rgba(191,176,101,0.2)"
      >
        La
      </span>
      <span
        class="block text-5xl font-black uppercase text-[#D4A017] sm:text-7xl md:text-8xl lg:text-9xl"
        style="text-shadow: 0 0 80px rgba(212,160,23,0.45), 0 8px 40px rgba(0,0,0,0.95), 0 2px 0 rgba(212,160,23,0.3)"
      >
        Aripuca
      </span>
    </h1>

    <!-- Ornamental divider -->
    <div class="hero-divider my-5 flex items-center gap-3 md:my-6">
      <div class="h-px w-10 bg-[#BFB065]/50 sm:w-16 md:w-24"></div>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="opacity-80">
        <path d="M10 0 L12 8 L20 10 L12 12 L10 20 L8 12 L0 10 L8 8 Z" fill="#BFB065"/>
      </svg>
      <div class="h-px w-10 bg-[#BFB065]/50 sm:w-16 md:w-24"></div>
    </div>

    <!-- Tagline -->
    <p
      class="hero-tagline font-title mb-2 text-sm font-bold uppercase tracking-[0.3em] text-[#D4A017] drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)] sm:text-base md:text-xl"
    >
      Único Atractivo Turístico en su Género
    </p>
    <p class="hero-sub font-title mb-10 text-xs italic text-white/65 tracking-widest sm:text-sm md:mb-12">
      Un monumento a la selva misionera
    </p>

    <!-- CTA buttons -->
    <div class="hero-cta flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a href="#informacion" class="w-full sm:w-auto">
        <button
          class="buttonHero w-full bg-[#8C3B17] text-white drop-shadow-xl transition-all duration-200 hover:scale-105 hover:bg-[#a8451c] hover:shadow-[0_0_28px_rgba(140,59,23,0.6)] sm:w-44"
        >
          Horarios
        </button>
      </a>
      <a href="#contacto" class="w-full sm:w-auto">
        <button
          class="buttonHero w-full border border-[#BFB065]/50 bg-[#BFB065]/10 text-white backdrop-blur-sm transition-all duration-200 hover:scale-105 hover:border-[#BFB065]/90 hover:bg-[#BFB065]/20 sm:w-44"
        >
          Ubicación
        </button>
      </a>
    </div>
  </div>

</section>

<style>
  .hero-badge {
    animation: heroFadeDown 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.1s;
  }
